{
  "version": 8,
  "name": "NaviTaxiMap Shortbread 1.0 fully local visual preview; no labels/legal boundaries",
  "sources": {
    "shortbread": {
      "type": "vector",
      "url": "__PMTILES_URL__",
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "© OpenStreetMap contributors (ODbL 1.0)"
    }
  },
  "layers": [
    {
      "id": "offline-bg",
      "type": "background",
      "paint": {
        "background-color": "#f3f5ef"
      }
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "ocean",
      "paint": {
        "fill-color": "#c4e0ec"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "land",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "forest",
            "wood"
          ],
          "#d4e6d0",
          [
            "grass",
            "meadow",
            "farmland"
          ],
          "#e5ebd5",
          [
            "residential",
            "commercial"
          ],
          "#eeece5",
          "#e9ece4"
        ]
      }
    },
    {
      "id": "water-polygons",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "water_polygons",
      "paint": {
        "fill-color": "#b5dce9"
      }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "shortbread",
      "source-layer": "water_lines",
      "paint": {
        "line-color": "#91c5d9",
        "line-width": 1.3
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d0c9c2",
        "fill-opacity": 0.78
      }
    },
    {
      "id": "streets-all",
      "type": "line",
      "source": "shortbread",
      "source-layer": "streets",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary",
            "unclassified",
            "residential",
            "service",
            "living_street",
            "busway",
            "pedestrian",
            "track",
            "footway",
            "path",
            "steps",
            "cycleway"
          ]
        ]
      ],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#275e6c",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.8,
          11,
          1.8,
          14,
          3.2,
          17,
          6.2
        ]
      }
    },
    {
      "id": "major-road-casing",
      "type": "line",
      "source": "shortbread",
      "source-layer": "streets",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary"
          ]
        ]
      ],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#946b4c",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          1.8,
          12,
          4.5,
          16,
          10
        ]
      }
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "shortbread",
      "source-layer": "streets",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary"
          ]
        ]
      ],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#f2ba6e",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          1.2,
          12,
          3.3,
          16,
          7.5
        ]
      }
    }
  ]
}
